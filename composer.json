{
    "name": "doxycomp/harvard-counter",
    "description": "Practice sentence picker and usage counter for voice coaches.",
    "type": "project",
    "license": "MIT",
    "readme": "README.md",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1"
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "lint": "@php bin/lint.php",
        "analyse": "phpstan analyse --memory-limit=512M --no-progress",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@lint",
            "@analyse",
            "@cs",
            "@php bin/check_translations.php",
            "@php bin/check_contrast.php"
        ]
    },
    "scripts-descriptions": {
        "lint": "Syntax-check every PHP file.",
        "analyse": "Static analysis with PHPStan.",
        "cs": "Report coding-style deviations without changing anything.",
        "cs:fix": "Apply the coding style.",
        "check": "Everything CI runs, in one go."
    }
}
